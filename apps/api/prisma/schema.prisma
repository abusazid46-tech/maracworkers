generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  MANAGER
  STAFF
}

enum BookingStatus {
  PENDING
  CONFIRMED
  ASSIGNED
  EN_ROUTE
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMode {
  COD
  RAZORPAY
  STRIPE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  WON
  LOST
}

model User {
  id           String    @id @db.VarChar(30) @default(cuid())
  role         UserRole  @default(CUSTOMER)
  name         String?   @db.VarChar(200)
  email        String?   @unique @db.VarChar(255)
  phone        String?   @unique @db.VarChar(20)
  googleId     String?   @unique @db.VarChar(255)
  avatarUrl    String?   @db.VarChar(512)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  addresses    Address[]
  bookings     Booking[]
  crmNotes     CrmNote[]
}

model AuthOtp {
  id         String    @id @db.VarChar(30) @default(cuid())
  phone      String    @db.VarChar(20)
  codeHash   String    @db.VarChar(255)
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
  @@index([expiresAt])
}

model Address {
  id        String   @id @db.VarChar(30) @default(cuid())
  userId    String?  @db.VarChar(30)
  label     String?  @db.VarChar(100)
  line1     String   @db.VarChar(500)
  line2     String?  @db.VarChar(500)
  city      String   @db.VarChar(100)
  state     String?  @db.VarChar(100)
  pincode   String?  @db.VarChar(10)
  latitude  Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model ServiceCategory {
  id          String    @id @db.VarChar(30) @default(cuid())
  name        String    @db.VarChar(200)
  slug        String    @unique @db.VarChar(200)
  description String?   @db.Text
  imageUrl    String?   @db.VarChar(512)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  services    Service[]
  offerBanners OfferBanner[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Service {
  id          String          @id @db.VarChar(30) @default(cuid())
  categoryId  String          @db.VarChar(30)
  name        String          @db.VarChar(200)
  slug        String          @unique @db.VarChar(200)
  description String          @db.Text
  icon        String?         @db.VarChar(100)
  imageUrl    String?         @db.VarChar(512)
  basePrice   Int
  groupLabel  String?         @db.VarChar(200)
  priceLabel  String?         @db.VarChar(200)
  originalPrice Int?
  originalPriceLabel String?  @db.VarChar(200)
  discountLabel String?       @db.VarChar(200)
  durationMin Int?
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  category    ServiceCategory @relation(fields: [categoryId], references: [id])
  bookingItems BookingItem[]
  offerBanners OfferBanner[]

  @@index([categoryId])
}

model OfferBanner {
  id            String           @id @db.VarChar(30) @default(cuid())
  title         String           @db.VarChar(300)
  subtitle      String?          @db.VarChar(500)
  serviceId     String?          @db.VarChar(30)
  categoryId    String?          @db.VarChar(30)
  imageUrl      String?          @db.VarChar(512)
  ctaLabel      String           @default("Book now") @db.VarChar(100)
  offerPrice    Int?
  originalPrice Int?
  discountText  String?          @db.VarChar(200)
  sortOrder     Int              @default(0)
  isActive      Boolean          @default(true)
  startsAt      DateTime?
  endsAt        DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  service       Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  category      ServiceCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([isActive, sortOrder])
  @@index([serviceId])
  @@index([categoryId])
  @@index([startsAt, endsAt])
}

model Booking {
  id                String             @id @db.VarChar(30) @default(cuid())
  bookingCode       String             @unique @db.VarChar(30) @default(cuid())
  userId            String?            @db.VarChar(30)
  customerName      String             @db.VarChar(200)
  customerPhone     String             @db.VarChar(20)
  addressLine       String             @db.VarChar(500)
  city              String             @db.VarChar(100)
  latitude          Decimal?           @db.Decimal(10, 7)
  longitude         Decimal?           @db.Decimal(10, 7)
  preferredDate     DateTime
  preferredTimeSlot String             @db.VarChar(50)
  notes             String?            @db.Text
  status            BookingStatus      @default(PENDING)
  paymentMode       PaymentMode        @default(COD)
  totalAmount       Int
  assignedStaffId   String?            @db.VarChar(30)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  user              User?              @relation(fields: [userId], references: [id])
  assignedStaff     Staff?             @relation(fields: [assignedStaffId], references: [id])
  items             BookingItem[]
  payments          Payment[]
  statusLogs        BookingStatusLog[]

  @@index([userId])
  @@index([assignedStaffId])
}

model BookingItem {
  id          String  @id @db.VarChar(30) @default(cuid())
  bookingId   String  @db.VarChar(30)
  serviceId   String? @db.VarChar(30)
  serviceName String  @db.VarChar(200)
  quantity    Int     @default(1)
  unitPrice   Int
  lineTotal   Int
  booking     Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service     Service? @relation(fields: [serviceId], references: [id])

  @@index([bookingId])
  @@index([serviceId])
}

model BookingStatusLog {
  id        String        @id @db.VarChar(30) @default(cuid())
  bookingId String        @db.VarChar(30)
  status    BookingStatus
  note      String?       @db.Text
  createdAt DateTime      @default(now())
  booking   Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Payment {
  id                String        @id @db.VarChar(30) @default(cuid())
  bookingId         String        @db.VarChar(30)
  provider          String        @db.VarChar(50)
  providerOrderId   String?       @db.VarChar(255)
  providerPaymentId String?       @db.VarChar(255)
  amount            Int
  currency          String        @default("INR") @db.VarChar(5)
  status            PaymentStatus @default(PENDING)
  rawPayload        Json?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
}

model Staff {
  id              String    @id @db.VarChar(30) @default(cuid())
  name            String    @db.VarChar(200)
  phone           String    @unique @db.VarChar(20)
  role            String?   @db.VarChar(100)
  isActive        Boolean   @default(true)
  currentLat      Decimal?  @db.Decimal(10, 7)
  currentLng      Decimal?  @db.Decimal(10, 7)
  lastHeading     Float?
  lastLocationAt  DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  bookings        Booking[]
}

model Lead {
  id        String     @id @db.VarChar(30) @default(cuid())
  name      String?    @db.VarChar(200)
  phone     String     @db.VarChar(20)
  email     String?    @db.VarChar(255)
  source    String?    @db.VarChar(100)
  status    LeadStatus @default(NEW)
  notes     String?    @db.Text
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CrmNote {
  id        String   @id @db.VarChar(30) @default(cuid())
  userId    String?  @db.VarChar(30)
  title     String   @db.VarChar(300)
  body      String   @db.Text
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
}

model WhatsappMessage {
  id          String   @id @db.VarChar(30) @default(cuid())
  phone       String   @db.VarChar(20)
  template    String?  @db.VarChar(200)
  direction   String   @db.VarChar(20)
  status      String   @db.VarChar(50)
  payload     Json?
  createdAt   DateTime @default(now())
}
