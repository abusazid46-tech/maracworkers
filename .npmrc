# Required for React Native / Expo to work correctly in pnpm monorepos.
# Hoisted layout ensures autolinking can find expo-modules-core and generate
# correct PackageList.java with expo.modules.ExpoModulesPackage (not expo.core).
node-linker=hoisted
public-hoist-pattern[]=*react-native*
public-hoist-pattern[]=*expo*
public-hoist-pattern[]=*@react-navigation*
